{"nodes": [{"id": "questions_05_rest_vs_message_queue_question", "label": "Q5: REST API vs message queue / event bus", "file_type": "document", "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_05_rest_vs_message_queue_five_minute_test", "label": "The five-minute downtime test", "file_type": "rationale", "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ask: if the other service is down for five minutes, should this operation fail? Yes \u2192 call it. No \u2192 publish it."}, {"id": "questions_05_rest_vs_message_queue_consumer_count_coupling", "label": "How many services care, and will that change", "file_type": "rationale", "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With REST the producer would need N calls and know every consumer by name; with an event a fourth consumer is a new class in a different repository. The coupling difference is worth more than the availability difference."}, {"id": "questions_05_rest_vs_message_queue_kafka_vs_rabbitmq", "label": "Kafka vs RabbitMQ", "file_type": "rationale", "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kafka is a distributed log with replay and offsets; RabbitMQ is a broker with routing, per-message acks and dead-lettering. This system needs routing and acks, so RabbitMQ."}, {"id": "questions_05_rest_vs_message_queue_dead_letter_queue", "label": "Dead-letter queue and poison messages", "file_type": "concept", "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry with backoff then dead-letter; never retry forever, because one poison message blocks everything behind it. The _error queue is the first place to look when a consumer 'isn't firing'."}, {"id": "questions_05_rest_vs_message_queue_queue_vs_topic", "label": "Queue vs topic (point-to-point vs pub/sub)", "file_type": "concept", "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queue = one message one consumer, right for commands; topic/exchange = every subscriber gets a copy, right for events. MassTransit gives each consumer its own queue bound to the exchange, so both are available."}], "edges": [{"source": "questions_05_rest_vs_message_queue_five_minute_test", "target": "questions_05_rest_vs_message_queue_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "weight": 1.0}, {"source": "questions_05_rest_vs_message_queue_consumer_count_coupling", "target": "questions_05_rest_vs_message_queue_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "weight": 1.0}, {"source": "questions_05_rest_vs_message_queue_kafka_vs_rabbitmq", "target": "questions_05_rest_vs_message_queue_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "weight": 1.0}, {"source": "questions_05_rest_vs_message_queue_queue_vs_topic", "target": "questions_03_how_do_microservices_communicate_command_vs_event", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "weight": 1.0}, {"source": "questions_05_rest_vs_message_queue_dead_letter_queue", "target": "questions_05_rest_vs_message_queue_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "weight": 1.0}, {"source": "questions_05_rest_vs_message_queue_five_minute_test", "target": "questions_04_sync_vs_async_temporal_coupling", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/questions/05-rest-vs-message-queue.md", "source_location": null, "weight": 1.0}], "hyperedges": []}