{"nodes": [{"id": "questions_08_ddd_question", "label": "Q8: Domain-Driven Design and microservices", "file_type": "document", "source_file": "docs/questions/08-ddd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_08_ddd_ubiquitous_language", "label": "Ubiquitous language", "file_type": "concept", "source_file": "docs/questions/08-ddd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escalate, Materialised, Realise, Provision \u2014 the PMO's words in the code, not UpdateStatus and SetFlag."}, {"id": "questions_08_ddd_aggregate", "label": "Aggregate as a consistency boundary", "file_type": "concept", "source_file": "docs/questions/08-ddd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One aggregate = one transaction. Things that must change atomically belong in the same aggregate and therefore the same service; aggregate boundaries are what cause (or avoid) distributed transactions."}, {"id": "questions_08_ddd_context_map", "label": "Context map", "file_type": "concept", "source_file": "docs/questions/08-ddd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_08_ddd_no_generic_repository", "label": "No generic IRepository<T> over EF Core", "file_type": "rationale", "source_file": "docs/questions/08-ddd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DbContext is already a unit of work plus a repository; wrapping it adds a forwarding layer whose benefit is swapping persistence, which a service owning its own database rarely does. Being able to say why a pattern was skipped is worth more than applying it."}, {"id": "questions_08_ddd_anaemic_domain_model", "label": "Anaemic domain model", "file_type": "concept", "source_file": "docs/questions/08-ddd.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A smell, not a sin. Risk.Escalate throwing once materialised is the single rule that stops a retried HTTP request starting the choreography chain twice."}], "edges": [{"source": "questions_08_ddd_ubiquitous_language", "target": "questions_08_ddd_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/08-ddd.md", "source_location": null, "weight": 1.0}, {"source": "questions_08_ddd_aggregate", "target": "questions_08_ddd_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/08-ddd.md", "source_location": null, "weight": 1.0}, {"source": "questions_08_ddd_context_map", "target": "questions_08_ddd_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/08-ddd.md", "source_location": null, "weight": 1.0}, {"source": "questions_08_ddd_no_generic_repository", "target": "questions_08_ddd_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/08-ddd.md", "source_location": null, "weight": 1.0}, {"source": "questions_08_ddd_anaemic_domain_model", "target": "questions_08_ddd_aggregate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/08-ddd.md", "source_location": null, "weight": 1.0}, {"source": "questions_08_ddd_question", "target": "questions_09_bounded_context_bounded_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/08-ddd.md", "source_location": null, "weight": 1.0}, {"source": "questions_08_ddd_aggregate", "target": "questions_12_distributed_transactions_avoid_the_saga", "relation": "conceptually_related_to"