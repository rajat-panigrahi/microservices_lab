{"nodes": [{"id": "questions_13_saga_pattern_question", "label": "Q13: The Saga pattern", "file_type": "document", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_13_saga_pattern_saga", "label": "Saga pattern", "file_type": "concept", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sequence of local transactions each with a compensating action; the answer to 'there is no distributed transaction'. Unlike a distributed transaction it is neither atomic nor isolated \u2014 each step commits and is visible immediately."}, {"id": "questions_13_saga_pattern_three_failure_modes", "label": "The three saga failure modes", "file_type": "rationale", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A leg refuses; a leg never answers (a 30-second scheduled timeout compensates, otherwise instances stick forever); and a leg answers late, after compensation began \u2014 caught in the Compensating state and followed by a withdrawal, otherwise the scorecard survives attached to a project that never activated."}, {"id": "questions_13_saga_pattern_participant_must_always_answer", "label": "Every participant must always answer", "file_type": "rationale", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WithdrawRiskRegisterConsumer confirms even when there was nothing to withdraw; answering only when there was work hangs the saga until its timeout. This was a real bug in the first version, caught by a test."}, {"id": "questions_13_saga_pattern_business_refusal_is_an_event", "label": "A business refusal is an event, not an exception", "file_type": "rationale", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thrown, it would be retried five times and dead-lettered while the saga waits for an answer that never comes, so the consumer catches the domain exception and publishes BenefitProfileRegistrationFailed."}, {"id": "questions_13_saga_pattern_persisted_saga_state", "label": "Saga state must be persisted with optimistic concurrency", "file_type": "rationale", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It must survive a restart \u2014 an orchestrator that forgets which legs succeeded cannot compensate \u2014 and three confirmations can land at the same instant, where without a concurrency token the last write silently discards the other two flags."}, {"id": "questions_13_saga_pattern_semantic_lock", "label": "Semantic lock (the Initiating stage)", "file_type": "rationale", "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A saga has no isolation, so other services can observe half-finished state. Mitigations are semantic locks (the aggregate refuses most operations while Initiating), commutative updates, and designing so partial state is not harmful to observe."}], "edges": [{"source": "questions_13_saga_pattern_saga", "target": "questions_13_saga_pattern_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_three_failure_modes", "target": "questions_13_saga_pattern_saga", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_participant_must_always_answer", "target": "questions_13_saga_pattern_three_failure_modes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_business_refusal_is_an_event", "target": "questions_13_saga_pattern_three_failure_modes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_persisted_saga_state", "target": "questions_13_saga_pattern_saga", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_semantic_lock", "target": "questions_13_saga_pattern_saga", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_question", "target": "questions_14_orchestration_vs_choreography_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_business_refusal_is_an_event", "target": "questions_05_rest_vs_message_queue_dead_letter_queue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/13-saga-pattern.md", "source_location": null, "weight": 1.0}, {"source": "questions_13_saga_pattern_semantic_lock", "target": "questions_16_eventual_consistency_make_the_window_visible", "relation": "semant