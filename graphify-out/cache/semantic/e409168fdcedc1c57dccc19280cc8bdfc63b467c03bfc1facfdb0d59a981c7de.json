{"nodes": [{"id": "questions_10_api_gateway_question", "label": "Q10: What is an API gateway", "file_type": "document", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_10_api_gateway_api_gateway", "label": "API gateway (YARP)", "file_type": "concept", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes /api/*, validates JWTs at the edge, rate limits per user, and aggregates five services into one document in ~480ms so a mobile client does not make five round trips."}, {"id": "questions_10_api_gateway_thin_gateway", "label": "The gateway must stay thin", "file_type": "rationale", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business rules, data access and workflow orchestration do not belong in it: the moment business logic moves in, every team is blocked on one deployable and you have a distributed monolith with a fancy front door. The saga lives in the Projects service for exactly that reason."}, {"id": "questions_10_api_gateway_graceful_degradation", "label": "Aggregation must degrade, not fail", "file_type": "rationale", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returning benefits.available = false beats a 500; an aggregation endpoint that fails on one unhealthy dependency out of four has multiplied the platform's failure rate by four."}, {"id": "questions_10_api_gateway_not_a_trust_boundary", "label": "The gateway is not a trust boundary", "file_type": "rationale", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything on the network that can reach a service can call it directly, so every service re-validates the JWT. Trusting a header the gateway supposedly set is how one compromised pod becomes a compromised platform; the check costs microseconds."}, {"id": "questions_10_api_gateway_backend_for_frontend", "label": "Backend-for-frontend", "file_type": "concept", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One gateway per client type; a single gateway serving both ends up with query parameters that mean 'which client are you'."}, {"id": "questions_10_api_gateway_single_point_of_entry", "label": "Single point of entry vs single point of failure", "file_type": "rationale", "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single point of entry is unavoidable; a single point of failure is a deployment choice \u2014 replicas: 2 behind a load balancer with a PodDisruptionBudget."}], "edges": [{"source": "questions_10_api_gateway_api_gateway", "target": "questions_10_api_gateway_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "weight": 1.0}, {"source": "questions_10_api_gateway_thin_gateway", "target": "questions_10_api_gateway_api_gateway", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/10-api-gateway.md", "source_location": null, "weight": 1.0}, {"source": "questions_10_api_gateway_graceful_degradation", "target": "questions_10_api_gateway_api_gateway", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/10-api-gateway.md", "source_location": 