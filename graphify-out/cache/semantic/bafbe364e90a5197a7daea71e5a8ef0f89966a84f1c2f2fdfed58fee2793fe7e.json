{"nodes": [{"id": "questions_06_advantages_and_challenges_question", "label": "Q6: Advantages and challenges of microservices", "file_type": "document", "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_06_advantages_and_challenges_independence", "label": "Independence as the core advantage", "file_type": "rationale", "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent deploy, scale, fault isolation and team autonomy each have a precondition; a system where all services share a database has none of the advantages and all of the costs."}, {"id": "questions_06_advantages_and_challenges_network_replaces_method_calls", "label": "You replaced method calls with a network", "file_type": "rationale", "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every challenge is a version of this one fact: the network fails, is slow and reorders, so you lose transactions and the stack trace and gain operational surface. Microservices trade development-time simplicity for deployment-time flexibility."}, {"id": "questions_06_advantages_and_challenges_distributed_monolith", "label": "Distributed monolith", "file_type": "concept", "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distribution does not clean up a mess, it just distributes it. If the pain is 'the code is messy' rather than 'we cannot release without three teams agreeing', the trade is a bad one."}, {"id": "questions_06_advantages_and_challenges_cost_table", "label": "Concrete cost of this repo vs a monolith", "file_type": "concept", "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20 lines and one transaction become a saga plus 6 contracts plus 3 compensating consumers; one SQL query becomes a read model with 17 projections, an inbox and a rebuild endpoint."}], "edges": [{"source": "questions_06_advantages_and_challenges_independence", "target": "questions_06_advantages_and_challenges_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "weight": 1.0}, {"source": "questions_06_advantages_and_challenges_network_replaces_method_calls", "target": "questions_06_advantages_and_challenges_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "weight": 1.0}, {"source": "questions_06_advantages_and_challenges_distributed_monolith", "target": "questions_06_advantages_and_challenges_independence", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "weight": 1.0}, {"source": "questions_06_advantages_and_challenges_cost_table", "target": "questions_06_advantages_and_challenges_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "weight": 1.0}, {"source": "questions_06_advantages_and_challenges_question", "target": "questions_12_distributed_transactions_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/06-advantages-and-challenges.md", "source_location": null, "weight