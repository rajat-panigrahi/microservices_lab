{"nodes": [{"id": "questions_03_how_do_microservices_communicate_question", "label": "Q3: How do microservices communicate", "file_type": "document", "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_03_how_do_microservices_communicate_synchronous_request_response", "label": "Synchronous request/response (HTTP, gRPC)", "file_type": "rationale", "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used when a human is waiting for a screen and an answer is needed now; cost is temporal coupling \u2014 both services must be up at the same instant."}, {"id": "questions_03_how_do_microservices_communicate_asynchronous_messaging", "label": "Asynchronous messaging over a broker", "file_type": "rationale", "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule applied: queries go synchronously, state changes go asynchronously. Publishing RiskEscalated returns immediately so Risk is not as available as its least available dependency."}, {"id": "questions_03_how_do_microservices_communicate_command_vs_event", "label": "Command vs event distinction", "file_type": "rationale", "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An event is past tense, published, zero-or-many subscribers; a command is imperative, sent, exactly one handler. A 'command' with three handlers is an event with a misleading name and couples three services to a sender that thinks it talks to one."}, {"id": "questions_03_how_do_microservices_communicate_riskescalated", "label": "RiskEscalated integration event", "file_type": "concept", "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_03_how_do_microservices_communicate_availability_multiplication", "label": "Availability multiplies across sync hops", "file_type": "rationale", "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five services at 99.9% called synchronously in a chain give ~99.5% \u2014 five times worse. Async makes a down consumer a waiting message rather than a failed request."}], "edges": [{"source": "questions_03_how_do_microservices_communicate_synchronous_request_response", "target": "questions_03_how_do_microservices_communicate_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "weight": 1.0}, {"source": "questions_03_how_do_microservices_communicate_asynchronous_messaging", "target": "questions_03_how_do_microservices_communicate_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "weight": 1.0}, {"source": "questions_03_how_do_microservices_communicate_command_vs_event", "target": "questions_03_how_do_microservices_communicate_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "weight": 1.0}, {"source": "questions_03_how_do_microservices_communicate_riskescalated", "target": "questions_03_how_do_microservices_communicate_asynchronous_messaging", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "weight": 1.0}, {"source": "questions_03_how_do_microservices_communicate_availability_multiplication", "target": "questions_03_how_do_microservices_communicate_synchronous_request_response", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "weight": 1.0}, {"source": "questions_03_how_do_microservices_communicate_question", "target": "questions_11_service_discovery_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/03-how-do-microservices-communicate.md", "source_location": null, "weight": 1.0}], "hyperedges": []}