{"nodes": [{"id": "questions_14_orchestration_vs_choreography_question", "label": "Q14: Saga choreography vs orchestration", "file_type": "document", "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_14_orchestration_vs_choreography_orchestration", "label": "Orchestration", "file_type": "concept", "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One coordinator sends commands and waits for answers; the flow lives in one file and stuck instances are a table query. The cost is that the orchestrator knows every participant by name."}, {"id": "questions_14_orchestration_vs_choreography_choreography", "label": "Choreography", "file_type": "concept", "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each service reacts to events and publishes its own; a fifth reaction needs no changes anywhere. The cost is that no file describes what happens, and debugging depends entirely on correlation ids."}, {"id": "questions_14_orchestration_vs_choreography_visibility_vs_coupling", "label": "Visibility versus coupling \u2014 the choosing rule", "file_type": "rationale", "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orchestrate when the outcome must be all-or-nothing, choreograph when the reactions are independently valuable. A project with a register but no benefit profile is broken; a benefit flagged before the RAG moves is merely incomplete. Systems drift into choreography because publishing is the easy next step, which is the strongest argument for orchestrating business-critical outcomes."}, {"id": "questions_14_orchestration_vs_choreography_escalation_chain", "label": "The choreographed risk-escalation chain", "file_type": "concept", "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RiskEscalated \u2192 Issues raises an issue \u2192 IssueRaised \u2192 Projects drops RAG to Red and Benefits flags the forecast; later IssueResolved closes the originating risk. Four services, no coordinator."}], "edges": [{"source": "questions_14_orchestration_vs_choreography_orchestration", "target": "questions_14_orchestration_vs_choreography_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_choreography", "target": "questions_14_orchestration_vs_choreography_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_visibility_vs_coupling", "target": "questions_14_orchestration_vs_choreography_orchestration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_visibility_vs_coupling", "target": "questions_14_orchestration_vs_choreography_choreography", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_escalation_chain", "target": "questions_14_orchestration_vs_choreography_choreography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_escalation_chain", "target": "questions_03_how_do_microservices_communicate_riskescalated", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_orchestration", "target": "questions_13_saga_pattern_saga", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}, {"source": "questions_14_orchestration_vs_choreography_choreography", "target": "questions_23_logging_and_monitoring_correlation_id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/14-orchestration-vs-choreography.md", "source_location": null, "weight": 1.0}], "hyperedges": []}