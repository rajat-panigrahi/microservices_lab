{"nodes": [{"id": "questions_12_distributed_transactions_question", "label": "Q12: Handling distributed transactions", "file_type": "document", "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_12_distributed_transactions_two_phase_commit", "label": "Two-phase commit (rejected)", "file_type": "rationale", "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds locks across a network round trip so throughput collapses, the coordinator is a single point of failure that can leave participants blocked, every participant must support it (RabbitMQ and most cloud databases do not), and it couples everyone's availability."}, {"id": "questions_12_distributed_transactions_rollback_is_a_business_operation", "label": "Rollback becomes a business operation", "file_type": "rationale", "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no undo: the work genuinely happened and is genuinely being reversed, visibly. Irreversible steps go last, or use semantic compensation \u2014 not 'unsend the email' but 'send an apology'; the business decides what the compensation is."}, {"id": "questions_12_distributed_transactions_compensating_action", "label": "Compensating action", "file_type": "concept", "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compensations should be simple and idempotent \u2014 delete a row and confirm \u2014 because a compensation that keeps failing is dead-lettered and needs a human on a genuinely inconsistent system."}, {"id": "questions_12_distributed_transactions_avoid_the_saga", "label": "The best saga is the one you do not need", "file_type": "rationale", "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregate boundaries caused this distributed transaction; if two things must be atomic, put them in the same aggregate and the same service. A saga is the price of a boundary you decided is worth it, not a default pattern."}], "edges": [{"source": "questions_12_distributed_transactions_two_phase_commit", "target": "questions_12_distributed_transactions_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "weight": 1.0}, {"source": "questions_12_distributed_transactions_rollback_is_a_business_operation", "target": "questions_12_distributed_transactions_compensating_action", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "weight": 1.0}, {"source": "questions_12_distributed_transactions_compensating_action", "target": "questions_13_saga_pattern_saga", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "weight": 1.0}, {"source": "questions_12_distributed_transactions_question", "target": "questions_16_eventual_consistency_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/12-distributed-transactions.md", "source_location": null, "weight": 1.0}, {"source": "questions_12_distributed_transactions_question", "target": "questions_19_idempotency_inbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 