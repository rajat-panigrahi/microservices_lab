{"nodes": [{"id": "questions_18_retry_and_circuit_breaker_question", "label": "Q18: Retry and Circuit Breaker patterns", "file_type": "document", "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_18_retry_and_circuit_breaker_retry", "label": "Retry with exponential backoff and jitter", "file_type": "concept", "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles transient faults \u2014 a dropped packet, a GC pause, a restarting pod. Jitter stops every caller retrying at the same instant. A retry is optimism."}, {"id": "questions_18_retry_and_circuit_breaker_circuit_breaker", "label": "Circuit breaker (closed / open / half-open)", "file_type": "concept", "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles sustained faults by failing fast so the caller stays responsive and the dependency gets breathing room. A breaker is knowing when to stop being optimistic. Thresholds here: 50% failure ratio over 20 seconds with a minimum of 5 calls, breaking for 15 seconds \u2014 the minimum throughput stops one failure out of one call reading as 100%."}, {"id": "questions_18_retry_and_circuit_breaker_policy_order", "label": "Resilience policy order", "file_type": "rationale", "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total timeout \u2192 retry \u2192 circuit breaker \u2192 per-attempt timeout. The breaker must sit inside the retry so it sees every individual attempt; outside it would see one failure per operation and trip far too late. The per-attempt timeout innermost stops one hung request consuming the whole budget."}, {"id": "questions_18_retry_and_circuit_breaker_retry_only_safe_and_5xx", "label": "Retry 5xx only, and only what is safe to repeat", "file_type": "rationale", "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 400 or 404 fails identically every time, so retrying wastes budget and multiplies load. Everything retried here is a GET; write paths go through the outbox and are made safe by the inbox instead."}, {"id": "questions_18_retry_and_circuit_breaker_retry_without_breaker", "label": "Retry without a breaker makes things worse", "file_type": "rationale", "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A struggling service gets three times the traffic exactly when it can least afford it, and callers pile up until their thread pools are exhausted \u2014 the cascade by which one slow service takes down a platform."}], "edges": [{"source": "questions_18_retry_and_circuit_breaker_retry", "target": "questions_18_retry_and_circuit_breaker_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_circuit_breaker", "target": "questions_18_retry_and_circuit_breaker_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_policy_order", "target": "questions_18_retry_and_circuit_breaker_circuit_breaker", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_policy_order", "target": "questions_18_retry_and_circuit_breaker_retry", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_retry_without_breaker", "target": "questions_18_retry_and_circuit_breaker_circuit_breaker", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_retry_only_safe_and_5xx", "target": "questions_18_retry_and_circuit_breaker_retry", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_question", "target": "questions_19_idempotency_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}, {"source": "questions_18_retry_and_circuit_breaker_retry_only_safe_and_5xx", "target": "questions_16_eventual_consistency_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/18-retry-and-circuit-breaker.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "synchronous_resilience_stack", "label": "The synchronous-call resilience stack", "nodes": ["questions_17_fault_tolerance_four_layers", "questions_18_retry_and_circuit_breaker_retry", "questions_18_retry_and_circuit_breaker_circuit_breaker", "questions_18_retry_and