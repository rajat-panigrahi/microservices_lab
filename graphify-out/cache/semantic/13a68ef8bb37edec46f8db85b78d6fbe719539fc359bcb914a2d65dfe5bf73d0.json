{"nodes": [{"id": "questions_19_idempotency_question", "label": "Q19: Duplicate messages and idempotency", "file_type": "document", "source_file": "docs/questions/19-idempotency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_19_idempotency_at_least_once_delivery", "label": "At-least-once delivery", "file_type": "concept", "source_file": "docs/questions/19-idempotency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly-once delivery does not exist across a network \u2014 it would need an atomic commit between broker and consumer database. Exactly-once processing does exist and is the consumer's job. Kafka's 'exactly-once semantics' is exactly-once processing within Kafka."}, {"id": "questions_19_idempotency_inbox", "label": "Inbox / idempotent consumer", "file_type": "concept", "source_file": "docs/questions/19-idempotency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The claim row and the business change must commit in ONE transaction; saving the claim separately opens a window where the service records 'handled' but crashes before doing the work, losing the message permanently. Keyed on (MessageId, Consumer) because one event often has several consumers in one service, and uniqueness is enforced by the database so two racing instances cannot both win. The table needs a retention job or it grows forever."}, {"id": "questions_19_idempotency_message_id_assigned_once", "label": "The message id is assigned once, at enqueue", "file_type": "rationale", "source_file": "docs/questions/19-idempotency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carried onto the wire deliberately, because MassTransit would otherwise mint a fresh id per publish attempt and a redelivery would look like a brand new message, defeating the whole mechanism."}, {"id": "questions_19_idempotency_three_layers", "label": "Three layers of duplicate defence", "file_type": "rationale", "source_file": "docs/questions/19-idempotency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The inbox catches the same message id again; a unique index catches two rows that must not both exist; a domain rule catches a business duplicate arriving with a fresh id. One layer is not enough because the inbox does nothing about a different message describing the same fact."}, {"id": "questions_19_idempotency_idempotency_key", "label": "HTTP idempotency key", "file_type": "concept", "source_file": "docs/questions/19-idempotency.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The client sends a unique header and the server replays the stored result for a repeat \u2014 what Stripe does for payments."}], "edges": [{"source": "questions_19_idempotency_at_least_once_delivery", "target": "questions_19_idempotency_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_inbox", "target": "questions_19_idempotency_at_least_once_delivery", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_message_id_assigned_once", "target": "questions_19_idempotency_inbox", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_three_layers", "target": "questions_19_idempotency_inbox", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_idempotency_key", "target": "questions_19_idempotency_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_message_id_assigned_once", "target": "questions_16_eventual_consistency_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_three_layers", "target": "questions_08_ddd_anaemic_domain_model", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_question", "target": "questions_05_rest_vs_message_queue_dead_letter_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}, {"source": "questions_19_idempotency_idempotency_key", "target": "questions_19_idempotency_inbox", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/questions/19-idempotency.md", "source_location": null, "weight": 1.0}], "hyperedges": []}