{"nodes": [{"id": "questions_04_sync_vs_async_question", "label": "Q4: Synchronous vs asynchronous communication", "file_type": "document", "source_file": "docs/questions/04-sync-vs-async.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_04_sync_vs_async_temporal_coupling", "label": "Temporal coupling", "file_type": "rationale", "source_file": "docs/questions/04-sync-vs-async.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The real difference between sync and async is not speed but whether both services must be up at the same instant. Async moves the difficulty from availability to observability \u2014 a queue growing quietly at 3am is harder to notice than a 500."}, {"id": "questions_04_sync_vs_async_fire_and_forget_fallacy", "label": "Async is not fire-and-forget", "file_type": "rationale", "source_file": "docs/questions/04-sync-vs-async.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At-least-once delivery with retries, a dead-letter queue and an outbox are required; 'async' without those is just losing data slowly."}, {"id": "questions_04_sync_vs_async_honest_intermediate_state", "label": "202 and honest intermediate state", "file_type": "rationale", "source_file": "docs/questions/04-sync-vs-async.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Return 202 with the resource and let the user see the state change arrive; the mistake is pretending it was synchronous and returning a success that has not happened yet. The saga's POST returns Initiating rather than a fake completion."}], "edges": [{"source": "questions_04_sync_vs_async_temporal_coupling", "target": "questions_04_sync_vs_async_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 