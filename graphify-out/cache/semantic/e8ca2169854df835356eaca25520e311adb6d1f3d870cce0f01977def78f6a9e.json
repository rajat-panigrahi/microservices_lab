{"nodes": [{"id": "questions_09_bounded_context_question", "label": "Q9: Bounded context and service definition", "file_type": "document", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_09_bounded_context_bounded_context", "label": "Bounded context", "file_type": "concept", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bounded context is the natural unit of a microservice: inside it the model is consistent and transactional, between contexts you translate and consistency is eventual. Never split a context across services; sometimes combine several into one service."}, {"id": "questions_09_bounded_context_canonical_model_failure", "label": "Why one canonical model fails", "file_type": "rationale", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared Project class accumulates every field, forces lockstep upgrades (the monolith with extra steps), and is wrong everywhere \u2014 nullable fields mandatory in one context and meaningless in another."}, {"id": "questions_09_bounded_context_shared_kernel", "label": "Shared kernel (StrategyOps.Contracts)", "file_type": "concept", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept deliberately small \u2014 only the contracts \u2014 because every shared type is a coordination cost."}, {"id": "questions_09_bounded_context_anti_corruption_layer", "label": "Anti-corruption layer", "file_type": "concept", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rebuild endpoint's local Upstream* records deliberately avoid referencing other services' DTOs, because sharing DTOs between producer and consumer is how two services quietly become one deployable."}, {"id": "questions_09_bounded_context_published_language", "label": "Published language (Contracts/V1)", "file_type": "concept", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_09_bounded_context_linguistic_test", "label": "The linguistic test for a boundary", "file_type": "rationale", "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Project' means a stage machine with a sponsor and budget in Projects, and just an id and a code in Risk. Same word, two models; similar data is not a shared context."}], "edges": [{"source": "questions_09_bounded_context_bounded_context", "target": "questions_09_bounded_context_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "questions_09_bounded_context_canonical_model_failure", "target": "questions_09_bounded_context_bounded_context", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "questions_09_bounded_context_shared_kernel", "target": "questions_09_bounded_context_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "questions_09_bounded_context_anti_corruption_layer", "target": "questions_09_bounded_context_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "questions_09_bounded_context_published_language", "target": "questions_09_bounded_context_shared_kernel", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "questions_09_bounded_context_linguistic_test", "target": "questions_09_bounded_context_bounded_context", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}, {"source": "questions_09_bounded_context_anti_corruption_layer", "target": "questions_15_cqrs_rebuild_read_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/09-bounded-context.md", "source_location": null, "weight": 1.0}], "hyperedges": []}