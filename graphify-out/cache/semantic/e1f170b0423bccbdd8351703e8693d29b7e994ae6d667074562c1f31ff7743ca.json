"weight": 1.0}], "hyperedges": [{"id": "eventual_consistency_toolkit", "label": "The three mechanisms that make eventual consistency safe", "nodes": ["questions_16_eventual_consistency_transactional_outbox", "questions_19_idempotency_inbox", "questions_13_saga_pattern_saga", "questions_12_distributed_transactions_compensating_action", "questions_16_eventual_consistency_eventual_consistency"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/16-eventual-consistency.md"}]}