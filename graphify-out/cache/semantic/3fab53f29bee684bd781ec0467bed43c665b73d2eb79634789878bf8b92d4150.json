{"nodes": [{"id": "questions_07_service_boundaries_question", "label": "Q7: Identifying microservice boundaries", "file_type": "document", "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "questions_07_service_boundaries_conways_law", "label": "Conway's law and rate/reason of change", "file_type": "rationale", "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Look for things that change for different reasons, at different rates, owned by different people \u2014 Conway's law and SRP pointing at the same place. Technical layers and one-service-per-table are the bad signals that produce distributed monoliths."}, {"id": "questions_07_service_boundaries_redeploy_test", "label": "The redeploy test", "file_type": "rationale", "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Change this; what else must ship? If the answer is 'another service', the boundary is wrong. Companion tests: chattiness, transaction, vocabulary."}, {"id": "questions_07_service_boundaries_risk_vs_issues", "label": "Risk vs Issues \u2014 similar tables, different contexts", "file_type": "rationale", "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They look identical but a risk register is reviewed monthly by a risk owner and an issue is chased daily against an SLA. The similarity of the tables is a trap."}, {"id": "questions_07_service_boundaries_vertical_slice", "label": "Vertical slice as an extraction seam", "file_type": "rationale", "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slice owns its whole path from HTTP to database, so 'which slices move?' has an answer. A layered codebase smears the use case across four projects and gives no seam."}, {"id": "questions_07_service_boundaries_start_coarse", "label": "Start coarse; merging beats splitting", "file_type": "rationale", "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging two services is much easier than splitting one, so start coarse and merge when two services are constantly chatty or always deploy together."}], "edges": [{"source": "questions_07_service_boundaries_conways_law", "target": "questions_07_service_boundaries_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_redeploy_test", "target": "questions_07_service_boundaries_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_risk_vs_issues", "target": "questions_07_service_boundaries_conways_law", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_vertical_slice", "target": "questions_07_service_boundaries_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_start_coarse", "target": "questions_07_service_boundaries_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_question", "target": "questions_09_bounded_context_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_question", "target": "questions_24_monolith_migration_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "questions_07_service_boundaries_risk_vs_issues", "target": "questions_09_bounded_context_linguistic_test", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/questions/07-service-boundaries.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "boundary_finding_method", "label": "Finding service boundaries: DDD, contexts and the practical tests", "nodes": ["questions_07_service_boundaries_redeploy_test", "questions_07_service_boundaries_conways_law", "questions_08_ddd_aggregate", "questions_09_bounded_context_bounded_context", "questions_09_bounded_context_linguistic_test", "questions_07_service_boundaries_vertical_slice"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/questions/07-service-boundaries.md"}]}