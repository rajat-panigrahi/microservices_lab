{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://strategyops.local/identity",
    "Audience": "strategyops-api",
    "SigningKey": "development-only-signing-key-change-me-in-any-real-environment",
    "AccessTokenMinutes": 30,
    "Enabled": true
  },
  "Discovery": {
    "Enabled": true,
    "RegistryUrl": "http://localhost:5108",
    "CacheSeconds": 10
  },
  "Resilience": {
    "AttemptTimeoutSeconds": 3,
    "TotalTimeoutSeconds": 12,
    "RetryCount": 3,
    "FailureRatio": 0.5,
    "SamplingDurationSeconds": 20,
    "MinimumThroughput": 5,
    "BreakDurationSeconds": 15
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "projects": {
        "ClusterId": "projects",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        },
        "AuthorizationPolicy": "read",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "objectives": {
        "ClusterId": "projects",
        "Match": {
          "Path": "/api/objectives/{**catch-all}"
        },
        "AuthorizationPolicy": "read",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "kpi": {
        "ClusterId": "kpi",
        "Match": {
          "Path": "/api/kpis/{**catch-all}"
        },
        "AuthorizationPolicy": "read",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "risk": {
        "ClusterId": "risk",
        "Match": {
          "Path": "/api/risks/{**catch-all}"
        },
        "AuthorizationPolicy": "read",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "issues": {
        "ClusterId": "issues",
        "Match": {
          "Path": "/api/issues/{**catch-all}"
        },
        "AuthorizationPolicy": "read",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "reporting": {
        "ClusterId": "reporting",
        "Match": {
          "Path": "/api/reporting/{**catch-all}"
        },
        "AuthorizationPolicy": "read",
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5107/"
          }
        }
      },
      "projects": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "kpi": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "risk": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "issues": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "benefits": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105/"
          }
        }
      },
      "reporting": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106/"
          }
        }
      }
    }
  },
  "Observability": {
    "OtlpEndpoint": "",
    "SeqUrl": "",
    "ConsoleTraces": false
  }
}
