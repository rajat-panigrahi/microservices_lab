{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Risk": "Data Source=strategyops-risk.db"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Issuer": "https://strategyops.local/identity",
    "Audience": "strategyops-api",
    "SigningKey": "development-only-signing-key-change-me-in-any-real-environment",
    "Enabled": true
  },
  "Discovery": {
    "Enabled": true,
    "RegistryUrl": "http://localhost:5108",
    "ServiceName": "risk-api",
    "SelfUrl": "http://localhost:5103",
    "LeaseSeconds": 30,
    "CacheSeconds": 10
  }
}
