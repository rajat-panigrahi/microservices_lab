{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Benefits": "Data Source=strategyops-benefits.db"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Benefits": {
    "ForecastMultiplier": 1.4,
    "PortfolioCeiling": 1000000
  },
  "Jwt": {
    "Issuer": "https://strategyops.local/identity",
    "Audience": "strategyops-api",
    "SigningKey": "development-only-signing-key-change-me-in-any-real-environment",
    "Enabled": true
  },
  "Discovery": {
    "Enabled": true,
    "RegistryUrl": "http://localhost:5108",
    "ServiceName": "benefits-api",
    "SelfUrl": "http://localhost:5105",
    "LeaseSeconds": 30,
    "CacheSeconds": 10
  },
  "Observability": {
    "OtlpEndpoint": "",
    "SeqUrl": "",
    "ConsoleTraces": false
  }
}
